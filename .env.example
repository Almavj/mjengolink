# Supabase project settings; use the PostgreSQL connection string for DATABASE_URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only: used to generate auth links; never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Frontend: set VITE_API_BASE_URL to the Render service origin at Vercel build time.
VITE_API_BASE_URL=
# Backend: comma-separated exact Vercel origins allowed to call the Render API.
CORS_ORIGINS=

# Authentication emails and job notifications are sent through Brevo.
# Create a Brevo API key and verify the sender address (or domain) before enabling delivery.
BREVO_API_KEY=
EMAIL_FROM=MjengoLink <notifications@your-verified-domain.example>
EMAIL_REPLY_TO=
